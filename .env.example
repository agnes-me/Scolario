# Copiez ce fichier en « .env » et complétez-le. Toutes les variables sont facultatives.

# Port d'écoute (défaut 3000)
PORT=3000
# Emplacement de la base SQLite (défaut ./data/scolario.db ; /data/scolario.db dans Docker)
# DB_PATH=./data/scolario.db
# Fuseau horaire (échéances de révision, fin de semaine / de mois)
TZ=Europe/Paris

# ── Synchronisation Notion ──
# Clé de l'intégration interne Notion (commence par « ntn_ » ou « secret_ »)
NOTION_TOKEN=
# Identifiants des 3 bases (valeurs par défaut = bases actuelles du projet)
# NOTION_DB_REFERENTIEL=5431f85462fa4744a926baffcee67a8d
# NOTION_DB_EXERCICES=5087654b71824013a74cda922f632b61
# NOTION_DB_LEITNER=d8bdd7bbe1eb4d109db85a682808ee6f
# Synchronisation automatique toutes les N heures (0 = manuelle uniquement)
NOTION_SYNC_INTERVAL_HOURS=24

# ── Sécurité ──
# Autoriser la création de nouveaux foyers après le premier (défaut : false)
ALLOW_REGISTRATION=false
# Mettre à true si l'application est servie en HTTPS (cookie « Secure »)
COOKIE_SECURE=false
# Derrière un reverse proxy (Synology, Caddy, Traefik…) : nombre de proxys à faire confiance
# TRUST_PROXY=1
