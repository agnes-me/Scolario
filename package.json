{
  "name": "scolario",
  "version": "1.0.0",
  "private": true,
  "description": "Suivi de scolarité familiale — auto-hébergeable, gratuit et open-source",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/src/index.js & vite --config client/vite.config.js",
    "dev:server": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/src/index.js",
    "sync:notion": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/src/cli/sync-notion.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.1"
  }
}
