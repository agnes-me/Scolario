# Copier en « .env » dans le même dossier que docker-compose.yml.

# Jeton du tunnel Cloudflare (Zero Trust › Réseaux › Tunnels › votre tunnel › Docker)
TUNNEL_TOKEN=

# Étiquette de l'image à déployer : « latest » = branche principale du dépôt.
# Tant que la branche principale n'existe pas, utiliser le nom de la branche de travail
# (les « / » deviennent des « - ») : claude-app-development-free-zh5de3
SCOLARIO_TAG=latest

# Synchronisation Notion (facultatif)
NOTION_TOKEN=
NOTION_SYNC_INTERVAL_HOURS=24
