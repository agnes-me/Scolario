# Copier en « .env » dans le même dossier que docker-compose.yml.

# Jeton du tunnel Cloudflare (Zero Trust › Réseaux › Tunnels › votre tunnel › Docker)
TUNNEL_TOKEN=

# Étiquette de l'image à déployer : « latest » = branche principale
SCOLARIO_TAG=latest

# Synchronisation Notion (facultatif)
NOTION_TOKEN=
NOTION_SYNC_INTERVAL_HOURS=24
